{
  "name": "app/woyofall",
  "description": "Application de gestion d'électricité Woyofall",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "vlucas/phpdotenv": "^5.5",
    "symfony/yaml": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Entity\\": "src/entity/",
      "App\\Repository\\": "src/repository/",
      "App\\Repository\\IRepository\\": "src/repository/irepository/",
      "App\\Service\\": "src/service/",
      "App\\Service\\IService\\": "src/service/iservice/",
      "App\\Enum\\": "src/enum/",
      "App\\Controller\\": "src/controller/",
      "App\\Controller\\IController\\": "src/controller/icontroller/",
      "App\\Core\\": "app/core/"
    },
    "classmap": [
      "src/"
    ]
  },
  "scripts": {
    "post-install-cmd": [
      "echo 'Skipping database setup in Docker build'"
    ]
  },
  "config": {
    "optimize-autoloader": true
  }
}
