{
  "name": "jeeri/appwoyofall",
  "description": "Réalisation d'un site web dénommé MAXITSA dans le cadre de notre apprentissage de la programmation orientée objet (POO) au sein de l'ODC (Orange Digital Center).",
  "autoload": {
    "psr-4": {
      "App\\Entity\\": "src/entity/",
      "App\\Repository\\": "src/repository/",
      "App\\Repository\\IRepository\\": "src/repository/irepository/",
      "App\\Service\\": "src/service/",
      "App\\Service\\IService\\": "src/service/iservice/",
      "App\\Enum\\": "src/enum/",
      "App\\Controller\\": "src/controller/",
      "App\\Controller\\IController\\": "src/controller/icontroller/"
    }
  },
  "scripts": {
    "database:migrate": "php migrations/migration.php",
    "database:seed": "php migrations/Seeder.php"
  },
  "authors": [
    {
      "name": "abdourahamanetinkindjeeri99",
      "email": "abdourahamanetinkindjeeri99@gmail.com"
    }
  ],
  "require": {
    "vlucas/phpdotenv": "^5.6",
    "ext-pdo": "*"
  }
}
